# ─────────────────────────────────────────────────────────────────────────────
# SafeVoice — Variables de entorno de ejemplo
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitees el .env real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno Django ─────────────────────────────────────────────────────────
# Opciones: config.settings.local | config.settings.test | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local

# Clave secreta de Django (genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=cambia-esta-clave-secreta-antes-de-usar

# Modo debug (True solo en local/test, nunca en producción)
DEBUG=True

# Hosts permitidos separados por coma (en producción pon el dominio real)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos SQL Server ───────────────────────────────────────────────
DB_ENGINE=mssql
DB_NAME=safevoice_db
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=1433

# Nombre del driver ODBC instalado en el sistema operativo.
# Opciones comunes: "ODBC Driver 18 for SQL Server" | "ODBC Driver 17 for SQL Server"
DB_DRIVER=ODBC Driver 18 for SQL Server

# ── CORS ───────────────────────────────────────────────────────────────────
# Orígenes del frontend permitidos, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── JWT ────────────────────────────────────────────────────────────────────
# Tiempo de vida del access token en minutos
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Tiempo de vida del refresh token en días
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
